{
  "otsgateway": {
    "enabled": true,
    "server_url": "http://localhost",
    "server_port": "3002",
    "log_file": "logs/otsgateway.log",
    "cors": {
      "enabled": false,
      "max_age_sec": 600
    },
    "watch_files": true,
    "watch_interval_sec": 5
  },
  "debug": {
    "enabled": true,
    "timeout_sec": 30,
    "on_timeout": "continue",
    "max_paused": 3,
    "allow_abort": true
  },
  "auth_server": {
    "internal": {
      "enabled": true,
      "token_endpoint": "/oauth/token",
      "port": "3003",
      "jwt_secret": "env:OTS_JWT_SECRET",
      "token_duration_minutes": 60,
      "bot_detection": {
        "enabled": true,
        "rate_per_minute": 10,
        "burst": 5
      }
    },
    "external": {
      "enabled": false,
      "jwks_url": "https://api.asgardeo.io/t/org4zfeo/oauth2/jwks"
    }
  },
  "dashboard": {
    "enabled": true,
    "port": "3004",
    "refresh_interval_sec": 2,
    "access_key": "8dadb7329fa02ead5b5df7e3d824fe4b",
    "log_file": "logs/dashboard.log"
  },
  "console": {
    "enabled": true,
    "port": "3005",
    "access_key": "26557c87c9c870a554b259c3d00d348f",
    "hash_new_credentials": true,
    "log_file": "logs/console.log"
  },
  "mock_server": {
    "enabled": true,
    "server_url": "http://localhost",
    "server_port": "3006",
    "log_file": "logs/mock_server.log",
    "auth_server": {
      "internal": {
        "enabled": false,
        "token_endpoint": "/oauth/token",
        "jwt_secret": "env:OTS_MOCK_JWT_SECRET",
        "token_duration_minutes": 30,
        "bot_detection": {
          "enabled": false,
          "rate_per_minute": 60,
          "burst": 10
        }
      },
      "external": {
        "enabled": false
      }
    }
  },
  "telemetry": {
    "enabled": true,
    "file": "logs/transactions.jsonl",
    "max_history": 500,
    "max_file_mb": 64
  },
  "plans": {
    "free": {
      "rate_per_second": 8,
      "burst": 5,
      "quota_hourly": 500,
      "quota_daily": 2000,
      "tokens_hourly": 50000,
      "tokens_daily": 400000,
      "max_tokens_per_call": 12000
    },
    "premium": {
      "rate_per_second": 20,
      "burst": 40,
      "quota_hourly": 5000,
      "quota_daily": 50000,
      "tokens_hourly": 1000000,
      "tokens_daily": 10000000,
      "max_tokens_per_call": 60000
    }
  },
  "mcps": [
    {
      "name": "botibank",
      "description": "Boti Bank OTS",
      "context_path": "/botibankots",
      "ots_file": "boti-bank-ots.yaml",
      "output": {
        "enforce": "warn"
      },
      "backend_server": [
        {
          "name": "Botibank MCP",
          "url": "https://localhost:8243/botibankmcp/1.0/mcp",
          "tls_skip_verify": false,
          "description": "Boti Bank Primary",
          "mock": {
            "enabled": false,
            "delay_ms": 100
          },
          "security": {
            "type": "OAuth2",
            "token_url": "https://localhost:9443/oauth2/token",
            "revoke_url": "https://localhost:9443/oauth2/revoke",
            "consumer_key": "env:BOTIBANK_CONSUMER_KEY",
            "consumer_secret": "env:BOTIBANK_CONSUMER_SECRET"
          }
        },
        {
          "name": "Botibank MCP Ext",
          "url": "https://localhost:8243/botibankext/1.0/mcp",
          "tls_skip_verify": true,
          "description": "Backend Boti Bank EXT OTS",
          "mock": {
            "enabled": true,
            "delay_ms": 100
          },
          "security": {
            "type": "OAuth2",
            "token_url": "https://localhost:9443/oauth2/token",
            "revoke_url": "https://localhost:9443/oauth2/revoke",
            "consumer_key": "env:BOTIBANK_CONSUMER_KEY",
            "consumer_secret": "env:BOTIBANK_CONSUMER_SECRET"
          }
        },
        {
          "name": "Botibank getCuentas",
          "url": "https://localhost:8243/getCuentas/1.0/mcp",
          "tls_skip_verify": true,
          "description": "Backend Boti Bank EXT OTS",
          "mock": {
            "enabled": false,
            "delay_ms": 100
          },
          "security": {
            "type": "OAuth2",
            "token_url": "https://localhost:9443/oauth2/token",
            "revoke_url": "https://localhost:9443/oauth2/revoke",
            "consumer_key": "env:BOTIBANK_CONSUMER_KEY",
            "consumer_secret": "env:BOTIBANK_CONSUMER_SECRET"
          }
        },
        {
          "name": "Botibank MariaDB",
          "url": "mariadb://127.0.0.1:3306/botibank?getConsultarCuentasByClienteId",
          "type": "database",
          "query_file": "sql/getConsultarCuentasByClienteId.sql",
          "cache": {
            "enabled": false
          },
          "tls_skip_verify": false,
          "description": "Obtiene las cuentas de un cliente específico desde la base de datos MariaDB",
          "security": {
            "type": "password",
            "token_url": "",
            "revoke_url": "",
            "consumer_key": "",
            "consumer_secret": "",
            "username": "pablo",
            "password": "env:DB_PASSWORD"
          },
          "mock": {
            "enabled": true,
            "delay_ms": 0
          }
        }
      ]
    }
  ],
